# Here we set a bunch of parameters for your image build

# output image name, must match the GitHub repository name: build.yml pushes
# ${IMAGE_NAME} from here while build-disk.yml pulls the repository name, so a
# mismatch breaks the disk build.
IMAGE_NAME=pixel-blue-china

# Make this the same as your github username/organisation
REPO_ORGANIZATION="zhchmmx"

IMAGE_DESC="Pixel Blue overlay for China: adds Chinese input method (ibus-rime) on top of ghcr.io/zhchmmx/pixel-blue."
IMAGE_KEYWORDS="bootc,oci,linux,fedora,silverblue,pixelbook,rime,chinese-input"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/65266359?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
