# Pixel Blue China gsettings defaults. glib-compile-schemas applies
# *.gschema.override files in sorted-filename order and an override replaces a
# whole key, so this file is named zz9- to sort after the base image's
# zz0-pixel-blue-modifications.gschema.override.
#
# Rime is installed by 10-packages.sh; without an entry in `sources` it is only
# reachable through Settings -> Keyboard -> Add Input Method, which most users
# never open. The layout stays first so the Latin alphabet is still available
# on its own key, and 雾凇拼音 handles Chinese.
#
# Applies to users who have never touched their input sources; anyone with an
# existing dconf value keeps it (see README, 中文适配).
[org.gnome.desktop.input-sources]
sources=[('xkb', 'us'), ('ibus', 'rime')]
