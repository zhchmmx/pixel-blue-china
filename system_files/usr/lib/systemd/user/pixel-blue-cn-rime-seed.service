[Unit]
Description=Seed the 雾凇拼音 (rime-ice) preset into the IBus Rime user directory
Documentation=https://github.com/iDvel/rime-ice
# The marker is written by rime-seed.sh. Delete it to seed again.
ConditionPathExists=!%h/.config/pixel-blue-cn/rime-seed.stamp
ConditionPathIsDirectory=/usr/share/pixel-blue-cn/rime

[Service]
Type=oneshot
# Invoked through the shell explicitly: the script under /usr/share is not an
# executables-path file, so it does not need an exec label.
ExecStart=/usr/bin/sh /usr/share/pixel-blue-cn/rime-seed.sh

[Install]
WantedBy=default.target
